# Application
APP_NAME=FolioPilot
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=foliopilot
POSTGRES_PASSWORD=foliopilot
POSTGRES_DB=foliopilot
DATABASE_URL=postgresql+asyncpg://foliopilot:foliopilot@localhost:5432/foliopilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (JWT_SECRET required without default outside development)
JWT_SECRET=dev-secret-key-do-not-use-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_GRACE_SECONDS=10
REFRESH_COOKIE_NAME=fp_refresh
TRUST_PROXY_HEADERS=false

# Test Isolation
TEST_DATABASE_URL=postgresql+asyncpg://foliopilot:foliopilot@localhost:5432/foliopilot_test
TEST_REDIS_URL=redis://localhost:6379/1

# CORS (JSON string array or comma-separated; cannot contain * in production)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend Web
NEXT_PUBLIC_API_URL=http://localhost:8000

